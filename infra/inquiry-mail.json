{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Homepage inquiry mail: Amplify SSR may send only info@zenlab.co.jp to info@zenlab.co.jp.",
  "Resources": {
    "InquiryComputeRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "amplify.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": "494003775664"
                },
                "ArnLike": {
                  "aws:SourceArn": "arn:aws:amplify:ap-northeast-1:494003775664:apps/dc082puu5tzbr*"
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "SendHomepageInquiryOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "ses:SendEmail",
                  "Resource": "arn:aws:ses:ap-northeast-1:494003775664:identity/info@zenlab.co.jp",
                  "Condition": {
                    "StringEquals": {
                      "ses:FromAddress": "info@zenlab.co.jp"
                    },
                    "ForAllValues:StringEquals": {
                      "ses:Recipients": [
                        "info@zenlab.co.jp"
                      ]
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "ComputeRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "InquiryComputeRole",
          "Arn"
        ]
      }
    }
  }
}
